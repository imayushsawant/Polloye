BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
DATABASE_URL="postgresql://polloye:polloye@localhost:5432/polloye?schema=public"
WS_JWT_SECRET="replace-with-ws-jwt-secret"
WS_INTERNAL_SECRET="replace-with-ws-internal-secret"
WS_SERVER_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
CRON_SECRET="replace-with-cron-secret"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=polloye-media
# Public bucket URL (custom domain or https://pub-….r2.dev). Either name works.
R2_PUBLIC_URL=
# R2_PUBLIC_BASE_URL=





# =============================================================================
# Local URLs: laptop-only vs phone + laptop (same Wi-Fi)
# =============================================================================
#
# Get your laptop Wi-Fi IPv4 with:  ipconfig
#
# --- A) Computer only (default day-to-day) ---
# Root .env:
#   BETTER_AUTH_URL="http://localhost:3000"
#   NEXT_PUBLIC_WS_URL="http://localhost:3001"
#   WS_SERVER_URL="http://localhost:3001"   # always localhost (Next → WS on same PC)
# ws-server/.env:
#   CORS_ORIGIN=http://localhost:3000
# Run: npm run dev   +   npm run dev:ws
# Open: http://localhost:3000
#
# --- B) Mobile + computer on same Wi-Fi ---
# Root .env (replace IP with yours from ipconfig):
#   BETTER_AUTH_URL="http://192.168.1.3:3000"
#   NEXT_PUBLIC_WS_URL="http://192.168.1.3:3001"
#   WS_SERVER_URL="http://localhost:3001"   # still localhost
# ws-server/.env:
#   CORS_ORIGIN=http://192.168.1.3:3000
# Also set next.config allowedDevOrigins to that IP (dev only).
# Run: npm run dev:lan   +   npm run dev:ws
# Open on phone AND laptop: http://192.168.1.3:3000   (http, NOT https)
# Restart both servers after changing env. Windows Firewall must allow TCP 3000 + 3001.
#
# Production: use real https:// domain URLs — never commit real secrets or LAN IPs.
# =============================================================================